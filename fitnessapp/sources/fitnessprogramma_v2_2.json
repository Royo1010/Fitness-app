{
  "metadata": {
    "title": "Vast fitnessprogramma v2.2 — tweeweekse Upper/Lower-cyclus",
    "status": "Vastgesteld voor Codex-update op basis van gesprek; belastbaarheid en 60-minuten-eis in praktijk bewaken",
    "timezone": "Europe/Amsterdam",
    "weekly_cycle": "Maandag 00:00 t/m zondag 23:59:59 lokale tijd; vervolgens automatisch andere variant",
    "default_workout_order": [
      "upper_a",
      "lower_a",
      "upper_b",
      "lower_b"
    ],
    "per_week_workouts": 4,
    "no_fixed_weekdays": true,
    "no_jiu_jitsu_in_app": true,
    "max_session_minutes_target": 60,
    "max_lower_exercises": 8,
    "exercise_variations_per_2_weeks": 5,
    "exercise_slots_per_week": 29,
    "supersets_required": false,
    "rehab_separate": true,
    "logging_rule": "Bestaande log-UX en historische records behouden; keuzeoefeningen afzonderlijk loggen",
    "exercise_details_rule": "Bestaande uitgebreide instructies behouden; nieuwe bent-over row voorzien van volledige instructies."
